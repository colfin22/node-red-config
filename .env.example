# Copy this to .env next to docker-compose.yml and fill in your own values.
# docker-compose.yml already loads it with `env_file: - .env`. Without that
# line the variables never reach the container.
#
# Imported a single flow from flows/ into an existing Node-RED instead? There
# is no compose file to read this, so set the same names in the editor:
# double-click the flow tab name, then the Environment Variables tab
# (needs Node-RED 2.1 or newer).
#
# Changing any value here needs `docker compose up -d`, NOT `docker restart`.
# A container's environment is fixed when it is created, so a plain restart
# quietly keeps the old values.

# ---------------------------------------------------------------------------
# People
# ---------------------------------------------------------------------------
# Who lives here, their roles, phones, notification channels and battery
# sensors are all set on the Household Config dashboard page
# (/dashboard/household), not here. Only two per-person values are still
# read from the environment, in numbered slots 1 to 8 (empty slots skipped):
#
#   _NAME             first name. The alarm speaks "Alice's bedroom window"
#                     for a sensor whose name starts with it, and the NFC tag
#                     and heating status name who did it
#   _HA_USER_ID       optional, their Home Assistant user id, used to say who
#                     changed the heating or scanned a tag. Find it under
#                     Settings > People. A slot may have a user id and no
#                     phone, e.g. a child with an account
#
# PERSON_n_ENTITY, _PING, _NOTIFY, _ROLE, _ONLY_WHEN_HOME and _BATTERY are no
# longer read anywhere; set those on the dashboard instead.

PERSON_1_NAME=Alice
PERSON_1_HA_USER_ID=

PERSON_2_NAME=Bob
PERSON_2_HA_USER_ID=

# ---------------------------------------------------------------------------
# Camera Concierge
# ---------------------------------------------------------------------------
# Base URL used to build the notification snapshot, GIF and clip links. No
# trailing slash. Any URL your phone can reach from outside the house works, a
# Nabu Casa address or your own domain. Never put an access token in here -
# the Frigate HA integration serves those /api/frigate/notifications/ paths
# unauthenticated on purpose. That integration (from HACS) is what answers
# those links, so the flow needs it installed.
NABU_URL=https://your-id.ui.nabu.casa

# MQTT broker that Frigate publishes to and Node-RED subscribes to.
MQTT_HOST=192.168.1.10

# ---------------------------------------------------------------------------
# Infra Watchdog and Infra Health & Alerts
# ---------------------------------------------------------------------------
# Uptime Kuma status page, used to reconcile monitor state. Both are the full
# URL: the status page config, and its heartbeat feed. The status-page API
# needs no authentication, but the page must be published for its monitors to
# be named. Replace 'homelab' with your own status page slug.
KUMA_STATUS_URL=http://192.168.1.20:3001/api/status-page/homelab
KUMA_HEARTBEAT_URL=http://192.168.1.20:3001/api/status-page/heartbeat/homelab

# Read-only Proxmox API token for the nightly backup check, the API base URL,
# and the node names to query (comma separated). Drop the backup watchdog
# nodes entirely if you do not run Proxmox.
# Format: PVEAPIToken=<user>@pve!<tokenid>=<secret>
PVE_API_TOKEN=
PVE_API_BASE=https://192.168.1.30:8006/api2/json/nodes/
PVE_NODES=pve

# ---------------------------------------------------------------------------
# Node-RED editor login
# ---------------------------------------------------------------------------
# adminAuth in data/settings.js reads both of these. The hash is bcrypt, and
# every $ must be escaped as $$ or compose eats it.
NR_ADMIN_USER=
NR_ADMIN_HASH=
