# Copy this to .env next to docker-compose.yml and fill in your own values.
# docker-compose.yml already loads it with `env_file: - .env`. Without that
# line the variables never reach the container.
#
# Imported a single flow from flows/ into an existing Node-RED instead? There
# is no compose file to read this, so set the same names in the editor:
# double-click the flow tab name, then the Environment Variables tab
# (needs Node-RED 2.1 or newer).

# Camera Concierge: base URL used to build the notification snapshot, GIF and
# clip links. No trailing slash. Any URL your phone can reach from outside the
# house works, a Nabu Casa address or your own domain. Never put an access
# token in here - the Frigate HA integration serves those /api/frigate/
# notifications/ paths unauthenticated on purpose. That integration (from
# HACS) is what answers those links, so the flow needs it installed.
NABU_URL=https://your-id.ui.nabu.casa

# Infra Watchdog: read-only Proxmox API token for the backup checks.
# Format: PVEAPIToken=<user>@pve!<tokenid>=<secret>
PVE_API_TOKEN=

# Node-RED editor login. adminAuth in data/settings.js reads both of these.
# The hash is bcrypt, and every $ must be escaped as $$ or compose eats it.
NR_ADMIN_USER=
NR_ADMIN_HASH=
